let val = rand(0, 100);

let guess = fn(x) {
	if (x == val) {
		return "you guessed it!"
	} else {
		if (x < val) {
			return "value is greater"
		} else {
			return "value is less"
		}
	}
}

let input = ""
let n = -1
println("Let's guess some values! Range is: 0 - 100")
print("type your first number:\n > ")
for (n != val) {
	input = scanln()
	try {
		n = atoi(input)
		const res = guess(n)
		print(res, "\n > ")
	} catch(_) {
		print("'", input, "' is not a number! Try one more time\n > ")
	}
}
