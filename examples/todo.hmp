const filename = "todos.md"

let tasks = []

let init = fn() { // creating file if not exists, reading it and returning the parsed data
	if (!exists(filename)) {
		create(filename)
	}

	const data = read(filename)
	return _parse(data);
}

let _parse = fn(data) {
	let i = 0
	let line = ""
	// each task is separated by ';' symbol
	for (i < len(data)) {
		let ch = data[i]
		if (ch == ";") { // if we found separator - push line to the tasks list, and clrear line
			tasks = push(tasks, line)
			line = ""
		} else { // else append ch to line
			line = line + ch
		}
		i = i+1
	}
}

let _save = fn() {
	let output = ""
	let i = 0
	// appending each task to output
	for (i < len(tasks)) {
		const data = tasks[i]
		if (len(data) != 0) {
			output = output + data + ";" // adding separator symbol at the end
		}
		i = i+1
	}

	write(filename, output)
}

let list = fn() {
	const reset = "\e[0m"
	const yellow = "\e[33m"
	const cyan = "\e[34m"

	let i = 0 // printing all tasks
	for (i < len(tasks)) {
		print(yellow, i, " ", cyan, tasks[i], reset)
		i++
	}
}

let main = fn() {
	const input = args()
	if (len(input) == 1 ) {
		list()
	}
	if (len(input)==3) {
		const cmd = input[1]
		const param = input[2]
		if (cmd == "new") {
			tasks = push(tasks, param)
		}
		if (cmd == "remove" || cmd == "complete") {
			const n = atoi(param)
			if (n<0 || n>=len(tasks)) {
				print("incorrect index ", n)
			} else {
				tasks[n] = ""
			}
		}
	}
}


init()  // reading existing tasks
main()  // reading user input and do what they ask us to do
_save() // saving all tasks (even if nothing was changed)
